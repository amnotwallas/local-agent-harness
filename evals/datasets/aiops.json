[
  {
    "test_id": "healthy-service",
    "category": "healthy",
    "task": "Assess orders-api health",
    "expected_tool_calls": [
      {
        "name": "get_service_health",
        "arguments": {
          "service_name": "orders-api"
        }
      }
    ],
    "required_facts": [
      "orders-api",
      "healthy"
    ],
    "unsupported_claims": [
      "database caused the issue"
    ],
    "expected_output_structure": [
      "request_id",
      "execution_id",
      "status",
      "final_answer",
      "tool_history",
      "model_calls",
      "model_duration_ms",
      "termination_reason"
    ],
    "max_tool_iterations": 5,
    "mock_tool_responses": {
      "get_service_health": {
        "service_name": "orders-api",
        "status": "healthy",
        "latency_ms": {
          "p50": 35,
          "p95": 110,
          "p99": 190
        },
        "error_rate": 0.001,
        "resource_utilization": {
          "cpu": 0.32,
          "memory": 0.57
        }
      }
    },
    "expected_tool_errors": 0
  },
